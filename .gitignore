# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Environments and secrets
.venv/
.env
.env.*

# OS / editors
.DS_Store
.idea/
.vscode/

# Models: never commit model files (model.pt alone is ~1.9 GB).
# Download them with scripts/download_model.py; git keeps only the empty folder placeholders.
models/*/*
!models/*/.gitkeep
# Model weights anywhere else in the repository
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin

# Data: the full CREMA-D dataset (606 MB) is not committed; download it with
# scripts/download_data.py --subset full. The six small test clips in data/samples/ are committed.
data/crema_d

# Outputs
outputs/
