# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Environments and secrets
.venv/
.env
.env.*

# OS / editors
.DS_Store
.idea/
.vscode/

# Emotion models: models/ is a Git submodule with small files and a GitHub Release downloader.
# setup_models.py retains previous local model folders here when upgrading an older checkout.
emotion_recognition/models.before-submodule-*/
# Anti-deepfake model weights are downloaded by that project's own scripts and stay local.
antideepfake/models/*/*
!antideepfake/models/*/.gitkeep
# The voice-cloning model files: a clone of the public repository Davidlequnchen/voice_clone_models (a git repository of its own)
antideepfake/models/voice_clone/
# Third-party code fetched by the download scripts (e.g. the CosyVoice repository at a pinned commit)
antideepfake/third_party/
# Model weights anywhere else in the repository
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin

# Data stays ignored by default. Selected local datasets are force-added for machines that cannot reach their
# hosts; see emotion_recognition/data/README.md for their scope and sources. Zenodo-hosted datasets are downloaded
# with emotion_recognition/scripts/common/download_data.py instead. ESD stays local.
emotion_recognition/data/*
!emotion_recognition/data/samples/
# Hidden states of the local audio LLMs (features/<model>/<dataset>/, a few GB; scripts/models/audio_llm.py)
emotion_recognition/features/
# antideepfake: only the synthetic call-centre texts are committed; voice recordings (references) stay local.
antideepfake/data/*
!antideepfake/data/voice_clone/
antideepfake/data/voice_clone/*
!antideepfake/data/voice_clone/texts.csv
!antideepfake/data/voice_clone/reference/
antideepfake/data/voice_clone/reference/*
!antideepfake/data/voice_clone/reference/.gitkeep
# Old locations, from before the split into emotion_recognition/ and antideepfake/: datasets and model files that
# another machine still has there after `git pull` stay ignored until they are moved into the new folders.
/data/
/models/

# Outputs. emotion_recognition/outputs/ (per-clip predictions of every model) is committed, except: the local results page
# (site/index.html is the public one), run logs (they hold local paths), and anything of ESD (its licence forbids
# sharing any part of the data). Other outputs/ folders stay local.
outputs/
!emotion_recognition/outputs/
emotion_recognition/outputs/*.html
emotion_recognition/outputs/*.log
emotion_recognition/outputs/**/esd_*

# labeling_tool: labels written by the tool (company data folders live outside this repository)
labeling_tool/**/annotations/*
!labeling_tool/**/annotations/.gitkeep
# Presentation deck: the Node packages and rendered previews are rebuilt locally
emotion_recognition/presentation/node_modules/
emotion_recognition/presentation/render/
# Office lock files
~$*
# Presentation: candidate clips that the deck does not use (regenerate with scripts/make_candidates.py)
emotion_recognition/presentation/assets/audio_candidates/
emotion_recognition/presentation/scripts/__pycache__/
