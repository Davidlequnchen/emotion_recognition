# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Environments and secrets
.venv/
.env
.env.*

# OS / editors
.DS_Store
.idea/
.vscode/

# Models: model files are ignored (model.pt alone is ~1.9 GB, xlsr_1b.ckpt 3.86 GB); download them with
# emotion_recognition/scripts/common/download_model.py or antideepfake/download_model.py. Exception, for a machine
# without Hugging Face: the weights of some emotion recognition models are committed as 90 MiB parts with their small
# files (force-added with `git add -f`, see emotion_recognition/models/README.md); the joined weights stay ignored.
emotion_recognition/models/*/*
!emotion_recognition/models/*/.gitkeep
antideepfake/models/*
!antideepfake/models/.gitkeep
# Model weights anywhere else in the repository
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin

# Data: datasets are never committed (size, and several licences forbid sharing copies).
# Download them with emotion_recognition/scripts/common/download_data.py. Only the six small CREMA-D test clips in
# emotion_recognition/data/samples/ are committed.
emotion_recognition/data/*
!emotion_recognition/data/samples/
# Old locations, from before the split into emotion_recognition/ and antideepfake/: datasets and model files that
# another machine still has there after `git pull` stay ignored until they are moved into the new folders.
/data/
/models/

# Outputs. emotion_recognition/outputs/ (per-clip predictions of every model) is committed, except: the local results page
# (site/index.html is the public one), run logs (they hold local paths), and anything of ESD (its licence forbids
# sharing any part of the data). Other outputs/ folders stay local.
outputs/
!emotion_recognition/outputs/
emotion_recognition/outputs/*.html
emotion_recognition/outputs/*.log
emotion_recognition/outputs/**/esd_*
